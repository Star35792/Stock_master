APP_NAME=stock-master
APP_ENV=dev
APP_DEBUG=true

# Embedded DuckDB single-file store (control plane + transactions + warm queries).
METADATA_DB_PATH=data/stock_master.duckdb

AKSHARE_TIMEOUT_SECONDS=30
TUSHARE_TOKEN=
# Collect supplier dividend evidence into raw on each auto-sync cycle.
# This never publishes market.corporate_action or unlocks backtests.
CORPORATE_ACTION_EVIDENCE_SYNC_ENABLED=false
CORPORATE_ACTION_AKSHARE_SYMBOLS_PER_RUN=10
CORPORATE_ACTION_TUSHARE_SYMBOLS_PER_RUN=1
# Daily raw-only lifecycle evidence collection with source fallback.
DELIST_EVIDENCE_SYNC_ENABLED=false
TURNOVER_EVIDENCE_SYNC_ENABLED=false
TURNOVER_EVIDENCE_SYMBOLS_PER_RUN=20

# HiThink Finance / 同花顺金融数据服务
HITHINK_FINANCE_API_KEY=
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_TIMEOUT_SECONDS=30
HITHINK_DUMP_CACHE_DIR=data/hithink_dumps
# API startup syncs daily data in the background, then checks again every hour.
AUTO_DATA_SYNC_ENABLED=true
AUTO_DATA_SYNC_INTERVAL_SECONDS=3600
DATA_LAKE_ROOT=data/warm
RAW_LANDING_ROOT=data/raw_landing
# When true, price factors read forward-adjusted bars from curated/prices_qfq Parquet.
FACTOR_READS_CURATED=false

EASTMONEY_TIMEOUT_SECONDS=15
EASTMONEY_RETRIES=2
XUEQIU_COOKIE=
XUEQIU_TIMEOUT_SECONDS=15
