APP_NAME=stock-master
APP_ENV=dev
APP_DEBUG=true

# Embedded DuckDB single-file store (control plane + transactions + warm queries).
METADATA_DB_PATH=data/stock_master.duckdb

AKSHARE_TIMEOUT_SECONDS=30

# HiThink Finance / 同花顺金融数据服务
HITHINK_FINANCE_API_KEY=
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_TIMEOUT_SECONDS=30
HITHINK_DUMP_CACHE_DIR=data/hithink_dumps
DATA_LAKE_ROOT=data/warm
# When true, price factors read forward-adjusted bars from curated/prices_qfq Parquet.
FACTOR_READS_CURATED=false

EASTMONEY_TIMEOUT_SECONDS=15
EASTMONEY_RETRIES=2
XUEQIU_COOKIE=
XUEQIU_TIMEOUT_SECONDS=15
