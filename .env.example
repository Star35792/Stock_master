APP_NAME=stock-master
APP_ENV=dev
APP_DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quant_db
POSTGRES_USER=quant
POSTGRES_PASSWORD=quant_password

# Either provide REDIS_URL directly, or use host/port/db/password fields below.
# REDIS_URL=redis://:redis_password@localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=

AKSHARE_TIMEOUT_SECONDS=30

# HiThink Finance / 同花顺金融数据服务
HITHINK_FINANCE_API_KEY=
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn
HITHINK_FINANCE_TIMEOUT_SECONDS=30
HITHINK_DUMP_CACHE_DIR=data/hithink_dumps
